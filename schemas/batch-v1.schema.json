{
  "$id": "https://agent-eval-runner.dev/schemas/batch-v1.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": ["schemaVersion", "id", "task", "configurations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1", "type": "string" },
    "id": {
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "type": "string"
    },
    "task": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "repository",
        "prompt",
        "budgets",
        "checks",
        "artifacts"
      ],
      "properties": {
        "schemaVersion": { "const": "1", "type": "string" },
        "id": {
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "type": "string"
        },
        "repository": {
          "additionalProperties": false,
          "type": "object",
          "required": ["path", "revision"],
          "properties": {
            "path": { "minLength": 1, "type": "string" },
            "revision": { "pattern": "^[0-9a-fA-F]{40}$", "type": "string" }
          }
        },
        "prompt": { "minLength": 1, "type": "string" },
        "budgets": {
          "additionalProperties": false,
          "type": "object",
          "required": ["wallClockMs", "maxCommands", "maxOutputBytes"],
          "properties": {
            "wallClockMs": { "minimum": 1, "type": "integer" },
            "maxCommands": { "minimum": 0, "type": "integer" },
            "maxOutputBytes": { "minimum": 1, "type": "integer" },
            "maxArtifactBytes": { "minimum": 1, "type": "integer" }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "kind", "command", "args", "timeoutMs"],
            "properties": {
              "id": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  { "const": "test", "type": "string" },
                  { "const": "lint", "type": "string" },
                  { "const": "custom", "type": "string" }
                ]
              },
              "command": { "minLength": 1, "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "minLength": 1, "maxLength": 1024, "type": "string" },
              "env": {
                "type": "object",
                "patternProperties": { "^(.*)$": { "type": "string" } }
              },
              "timeoutMs": { "minimum": 1, "type": "integer" }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["path", "mediaType"],
            "properties": {
              "path": { "minLength": 1, "maxLength": 1024, "type": "string" },
              "mediaType": { "minLength": 1, "type": "string" }
            }
          }
        }
      },
      "$id": "https://agent-eval-runner.dev/schemas/batch-common-task-v1"
    },
    "configurations": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "adapter", "repetitions"],
        "properties": {
          "id": {
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "type": "string"
          },
          "adapter": {
            "additionalProperties": false,
            "type": "object",
            "required": ["kind", "actions"],
            "properties": {
              "kind": { "const": "fake", "type": "string" },
              "actions": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": ["kind", "path", "content"],
                      "properties": {
                        "kind": { "const": "writeFile", "type": "string" },
                        "path": {
                          "minLength": 1,
                          "maxLength": 1024,
                          "type": "string"
                        },
                        "content": { "type": "string" }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": ["kind", "command", "args"],
                      "properties": {
                        "kind": { "const": "runCommand", "type": "string" },
                        "command": { "minLength": 1, "type": "string" },
                        "args": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "cwd": {
                          "minLength": 1,
                          "maxLength": 1024,
                          "type": "string"
                        },
                        "env": {
                          "type": "object",
                          "patternProperties": {
                            "^(.*)$": { "type": "string" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "repetitions": { "minimum": 1, "maximum": 1000, "type": "integer" }
        }
      }
    }
  }
}
