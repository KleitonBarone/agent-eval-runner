{
  "$id": "https://agent-eval-runner.dev/schemas/result-v7.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "resourceAccounting",
    "safety",
    "execution",
    "runner",
    "task",
    "taskSha256",
    "comparisonSha256",
    "adapterSha256",
    "usage",
    "status",
    "source",
    "attempt",
    "commands",
    "patch",
    "artifacts",
    "checks",
    "score",
    "events",
    "errors",
    "workspace"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "7", "type": "string" },
    "resourceAccounting": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "unmanaged", "type": "string" } }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "policyVersion",
            "limits",
            "poolId",
            "reservationId",
            "reserved",
            "resultBytesLimit",
            "resultPath"
          ],
          "properties": {
            "kind": { "const": "managed", "type": "string" },
            "policyVersion": {
              "const": "resource-admission-v1",
              "type": "string"
            },
            "limits": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "poolBytes",
                "poolEntries",
                "dockerVolumeBytes",
                "dockerContainers",
                "dockerVolumes",
                "records"
              ],
              "properties": {
                "poolBytes": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "poolEntries": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "dockerVolumeBytes": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "dockerContainers": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "dockerVolumes": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "records": { "minimum": 1, "maximum": 1000, "type": "integer" }
              }
            },
            "poolId": {
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "reservationId": {
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "reserved": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "poolBytes",
                "poolEntries",
                "dockerVolumeBytes",
                "dockerContainers",
                "dockerVolumes",
                "records"
              ],
              "properties": {
                "poolBytes": { "const": 805306368, "type": "number" },
                "poolEntries": { "const": 60000, "type": "number" },
                "dockerVolumeBytes": { "const": 402653184, "type": "number" },
                "dockerContainers": { "const": 4, "type": "number" },
                "dockerVolumes": { "const": 2, "type": "number" },
                "records": { "const": 1, "type": "number" }
              }
            },
            "resultBytesLimit": { "const": 134217728, "type": "number" },
            "resultPath": { "type": "string" }
          }
        }
      ]
    },
    "safety": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "checkout",
        "patch",
        "workspaceBytes",
        "fileBytes",
        "workspaceEntries",
        "pathDepth",
        "patchBytes",
        "totalArtifactBytes",
        "gitMetadataBytes",
        "phaseTimeoutMs"
      ],
      "properties": {
        "version": {
          "const": "raw-git-and-bounded-capture-v1",
          "type": "string"
        },
        "checkout": { "const": "raw_blobs", "type": "string" },
        "patch": { "const": "all_regular_files", "type": "string" },
        "workspaceBytes": { "const": 67108864, "type": "number" },
        "fileBytes": { "const": 16777216, "type": "number" },
        "workspaceEntries": { "const": 10000, "type": "number" },
        "pathDepth": { "const": 32, "type": "number" },
        "patchBytes": { "const": 8388608, "type": "number" },
        "totalArtifactBytes": { "const": 8388608, "type": "number" },
        "gitMetadataBytes": { "const": 2097152, "type": "number" },
        "phaseTimeoutMs": { "const": 30000, "type": "number" }
      }
    },
    "execution": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind", "policyVersion"],
          "properties": {
            "kind": { "const": "local", "type": "string" },
            "policyVersion": {
              "const": "trusted-worktree-v1",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "policyVersion",
            "preparation",
            "requestedImage",
            "imageId",
            "architecture",
            "node",
            "engineVersion",
            "uid",
            "gid",
            "containerId",
            "containerName",
            "cleanup",
            "workspacePath",
            "storage",
            "policy"
          ],
          "properties": {
            "kind": { "const": "docker", "type": "string" },
            "policyVersion": {
              "const": "linux-container-v3",
              "type": "string"
            },
            "preparation": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "requestedImage",
                "imageId",
                "architecture",
                "node",
                "engineVersion",
                "uid",
                "gid",
                "containerId",
                "containerName",
                "cleanup",
                "workspacePath",
                "storage",
                "policyVersion",
                "policy",
                "git",
                "snapshotSha256",
                "snapshotBytes",
                "snapshotEntries",
                "workerSha256",
                "inputPath"
              ],
              "properties": {
                "requestedImage": {
                  "const": "node@sha256:9137a20e25879e0b557227b57e3ee4e9af4bde29eb3db66134cd1723e84f830b",
                  "type": "string"
                },
                "imageId": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "architecture": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "node": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                "engineVersion": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "uid": {
                  "anyOf": [
                    { "minimum": 1, "type": "integer" },
                    { "type": "null" }
                  ]
                },
                "gid": {
                  "anyOf": [
                    { "minimum": 0, "type": "integer" },
                    { "type": "null" }
                  ]
                },
                "containerId": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "containerName": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "cleanup": {
                  "anyOf": [
                    { "const": "not_created", "type": "string" },
                    { "const": "pending", "type": "string" },
                    { "const": "removed", "type": "string" },
                    { "const": "failed", "type": "string" }
                  ]
                },
                "workspacePath": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "storage": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "volumeName",
                    "holderName",
                    "holderId",
                    "verified",
                    "cleanup"
                  ],
                  "properties": {
                    "volumeName": {
                      "anyOf": [{ "type": "string" }, { "type": "null" }]
                    },
                    "holderName": {
                      "anyOf": [{ "type": "string" }, { "type": "null" }]
                    },
                    "holderId": {
                      "anyOf": [{ "type": "string" }, { "type": "null" }]
                    },
                    "verified": { "type": "boolean" },
                    "cleanup": {
                      "anyOf": [
                        { "const": "not_created", "type": "string" },
                        { "const": "pending", "type": "string" },
                        { "const": "removed", "type": "string" },
                        { "const": "retained", "type": "string" },
                        { "const": "failed", "type": "string" }
                      ]
                    }
                  }
                },
                "policyVersion": {
                  "const": "git-preparation-v1",
                  "type": "string"
                },
                "policy": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "source",
                    "snapshotBytes",
                    "snapshotFileBytes",
                    "snapshotEntries",
                    "transferBytes",
                    "container"
                  ],
                  "properties": {
                    "source": {
                      "const": "objects_only_snapshot",
                      "type": "string"
                    },
                    "snapshotBytes": { "const": 268435456, "type": "number" },
                    "snapshotFileBytes": {
                      "const": 134217728,
                      "type": "number"
                    },
                    "snapshotEntries": { "const": 20000, "type": "number" },
                    "transferBytes": { "const": 100663296, "type": "number" },
                    "container": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "network",
                        "readOnlyRoot",
                        "capabilities",
                        "noNewPrivileges",
                        "memoryBytes",
                        "cpus",
                        "pids",
                        "temporaryBytes",
                        "temporaryInodes",
                        "workspaceStorage",
                        "workspaceBytes",
                        "workspaceInodes",
                        "storageLifecycle",
                        "sourceMetadata",
                        "hostCredentials",
                        "dockerSocket",
                        "commandLifecycle"
                      ],
                      "properties": {
                        "network": { "const": "none", "type": "string" },
                        "readOnlyRoot": { "const": true, "type": "boolean" },
                        "capabilities": { "const": "none", "type": "string" },
                        "noNewPrivileges": { "const": true, "type": "boolean" },
                        "memoryBytes": { "const": 805306368, "type": "number" },
                        "cpus": { "const": 1, "type": "number" },
                        "pids": { "const": 128, "type": "number" },
                        "temporaryBytes": {
                          "const": 67108864,
                          "type": "number"
                        },
                        "temporaryInodes": { "const": 4096, "type": "number" },
                        "workspaceStorage": {
                          "const": "local_tmpfs_volume",
                          "type": "string"
                        },
                        "workspaceBytes": {
                          "const": 268435456,
                          "type": "number"
                        },
                        "workspaceInodes": { "const": 40000, "type": "number" },
                        "storageLifecycle": {
                          "const": "read_only_holder",
                          "type": "string"
                        },
                        "sourceMetadata": { "const": false, "type": "boolean" },
                        "hostCredentials": {
                          "const": false,
                          "type": "boolean"
                        },
                        "dockerSocket": { "const": false, "type": "boolean" },
                        "commandLifecycle": {
                          "const": "restart_per_command",
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "git": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                "snapshotSha256": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "snapshotBytes": {
                  "anyOf": [
                    { "minimum": 0, "type": "integer" },
                    { "type": "null" }
                  ]
                },
                "snapshotEntries": {
                  "anyOf": [
                    { "minimum": 0, "type": "integer" },
                    { "type": "null" }
                  ]
                },
                "workerSha256": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "inputPath": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                }
              }
            },
            "requestedImage": { "type": "string" },
            "imageId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "architecture": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "node": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "engineVersion": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "uid": {
              "anyOf": [{ "minimum": 1, "type": "integer" }, { "type": "null" }]
            },
            "gid": {
              "anyOf": [{ "minimum": 0, "type": "integer" }, { "type": "null" }]
            },
            "containerId": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "containerName": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "cleanup": {
              "anyOf": [
                { "const": "not_created", "type": "string" },
                { "const": "pending", "type": "string" },
                { "const": "removed", "type": "string" },
                { "const": "failed", "type": "string" }
              ]
            },
            "workspacePath": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "storage": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "volumeName",
                "holderName",
                "holderId",
                "verified",
                "cleanup"
              ],
              "properties": {
                "volumeName": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "holderName": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "holderId": {
                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                },
                "verified": { "type": "boolean" },
                "cleanup": {
                  "anyOf": [
                    { "const": "not_created", "type": "string" },
                    { "const": "pending", "type": "string" },
                    { "const": "removed", "type": "string" },
                    { "const": "retained", "type": "string" },
                    { "const": "failed", "type": "string" }
                  ]
                }
              }
            },
            "policy": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "network",
                "readOnlyRoot",
                "capabilities",
                "noNewPrivileges",
                "memoryBytes",
                "cpus",
                "pids",
                "temporaryBytes",
                "temporaryInodes",
                "workspaceStorage",
                "workspaceBytes",
                "workspaceInodes",
                "storageLifecycle",
                "sourceMetadata",
                "hostCredentials",
                "dockerSocket",
                "commandLifecycle"
              ],
              "properties": {
                "network": { "const": "none", "type": "string" },
                "readOnlyRoot": { "const": true, "type": "boolean" },
                "capabilities": { "const": "none", "type": "string" },
                "noNewPrivileges": { "const": true, "type": "boolean" },
                "memoryBytes": { "const": 536870912, "type": "number" },
                "cpus": { "const": 1, "type": "number" },
                "pids": { "const": 128, "type": "number" },
                "temporaryBytes": { "const": 67108864, "type": "number" },
                "temporaryInodes": { "const": 4096, "type": "number" },
                "workspaceStorage": {
                  "const": "local_tmpfs_volume",
                  "type": "string"
                },
                "workspaceBytes": { "const": 134217728, "type": "number" },
                "workspaceInodes": { "const": 12000, "type": "number" },
                "storageLifecycle": {
                  "const": "read_only_holder",
                  "type": "string"
                },
                "sourceMetadata": { "const": false, "type": "boolean" },
                "hostCredentials": { "const": false, "type": "boolean" },
                "dockerSocket": { "const": false, "type": "boolean" },
                "commandLifecycle": {
                  "const": "restart_per_command",
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "runner": {
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "version", "node", "platform", "arch"],
      "properties": {
        "name": { "const": "agent-eval-runner", "type": "string" },
        "version": { "type": "string" },
        "node": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "task": {
      "$id": "https://agent-eval-runner.dev/schemas/task-v1.schema.json",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "repository",
        "prompt",
        "adapter",
        "budgets",
        "checks",
        "artifacts"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "1", "type": "string" },
        "id": {
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "type": "string"
        },
        "repository": {
          "additionalProperties": false,
          "type": "object",
          "required": ["path", "revision"],
          "properties": {
            "path": { "minLength": 1, "type": "string" },
            "revision": { "pattern": "^[0-9a-fA-F]{40}$", "type": "string" }
          }
        },
        "prompt": { "minLength": 1, "type": "string" },
        "execution": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "local", "type": "string" } }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["kind", "image"],
              "properties": {
                "kind": { "const": "docker", "type": "string" },
                "image": {
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9./:_-]*@sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            }
          ]
        },
        "adapter": {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind", "actions"],
          "properties": {
            "kind": { "const": "fake", "type": "string" },
            "actions": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": ["kind", "path", "content"],
                    "properties": {
                      "kind": { "const": "writeFile", "type": "string" },
                      "path": {
                        "minLength": 1,
                        "maxLength": 1024,
                        "type": "string"
                      },
                      "content": { "type": "string" }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": ["kind", "command", "args"],
                    "properties": {
                      "kind": { "const": "runCommand", "type": "string" },
                      "command": { "minLength": 1, "type": "string" },
                      "args": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "cwd": {
                        "minLength": 1,
                        "maxLength": 1024,
                        "type": "string"
                      },
                      "env": {
                        "type": "object",
                        "patternProperties": { "^(.*)$": { "type": "string" } }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "budgets": {
          "additionalProperties": false,
          "type": "object",
          "required": ["wallClockMs", "maxCommands", "maxOutputBytes"],
          "properties": {
            "wallClockMs": { "minimum": 1, "type": "integer" },
            "maxCommands": { "minimum": 0, "type": "integer" },
            "maxOutputBytes": { "minimum": 1, "type": "integer" },
            "maxArtifactBytes": { "minimum": 1, "type": "integer" }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "kind", "command", "args", "timeoutMs"],
            "properties": {
              "id": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  { "const": "test", "type": "string" },
                  { "const": "lint", "type": "string" },
                  { "const": "custom", "type": "string" }
                ]
              },
              "command": { "minLength": 1, "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "minLength": 1, "maxLength": 1024, "type": "string" },
              "env": {
                "type": "object",
                "patternProperties": { "^(.*)$": { "type": "string" } }
              },
              "timeoutMs": { "minimum": 1, "type": "integer" }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["path", "mediaType"],
            "properties": {
              "path": { "minLength": 1, "maxLength": 1024, "type": "string" },
              "mediaType": { "minLength": 1, "type": "string" }
            }
          }
        }
      }
    },
    "taskSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "comparisonSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "adapterSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "required": ["modelTokens", "modelCostUsd"],
      "properties": {
        "modelTokens": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["status", "source", "value"],
              "properties": {
                "status": { "const": "known", "type": "string" },
                "source": {
                  "anyOf": [
                    { "const": "measured", "type": "string" },
                    { "const": "not_applicable", "type": "string" }
                  ]
                },
                "value": { "minimum": 0, "type": "integer" }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "unknown", "type": "string" },
                "reason": { "minLength": 1, "type": "string" }
              }
            }
          ]
        },
        "modelCostUsd": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["status", "source", "value"],
              "properties": {
                "status": { "const": "known", "type": "string" },
                "source": {
                  "anyOf": [
                    { "const": "measured", "type": "string" },
                    { "const": "not_applicable", "type": "string" }
                  ]
                },
                "value": { "minimum": 0, "type": "number" }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "unknown", "type": "string" },
                "reason": { "minLength": 1, "type": "string" }
              }
            }
          ]
        }
      }
    },
    "status": {
      "anyOf": [
        { "const": "succeeded", "type": "string" },
        { "const": "failed", "type": "string" },
        { "const": "interrupted", "type": "string" }
      ]
    },
    "source": {
      "additionalProperties": false,
      "type": "object",
      "required": ["repositoryPath", "requestedRevision", "resolvedRevision"],
      "properties": {
        "repositoryPath": { "type": "string" },
        "requestedRevision": { "type": "string" },
        "resolvedRevision": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "attempt": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
