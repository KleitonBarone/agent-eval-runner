{
  "anyOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": ["schemaVersion", "kind", "revision"],
      "properties": {
        "schemaVersion": { "const": "1", "type": "string" },
        "kind": { "const": "prepare", "type": "string" },
        "revision": { "pattern": "^[0-9a-fA-F]{40}$", "type": "string" }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": ["schemaVersion", "kind", "files"],
      "properties": {
        "schemaVersion": { "const": "1", "type": "string" },
        "kind": { "const": "patch", "type": "string" },
        "files": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["path", "mode", "contentBase64", "sha256"],
            "properties": {
              "path": { "maxLength": 1024, "type": "string" },
              "mode": {
                "anyOf": [
                  { "const": "100644", "type": "string" },
                  { "const": "100755", "type": "string" }
                ]
              },
              "contentBase64": { "maxLength": 22369624, "type": "string" },
              "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
            }
          }
        }
      }
    }
  ]
}
