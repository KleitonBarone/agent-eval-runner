{
  "$id": "https://agent-eval-runner.dev/schemas/comparison-v1.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "batchId",
    "comparisonSha256",
    "scoringVersion",
    "rows",
    "summary",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "1", "type": "string" },
    "batchId": { "type": "string" },
    "comparisonSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "scoringVersion": { "const": "2", "type": "string" },
    "rows": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "state",
              "id",
              "configurationId",
              "repetition",
              "resultFile",
              "resultSha256",
              "taskSha256",
              "adapterSha256",
              "adapter",
              "runner",
              "source",
              "status",
              "outcome",
              "score",
              "checks",
              "durationMs",
              "commandCount",
              "patchBytes",
              "usage",
              "errors"
            ],
            "properties": {
              "state": { "const": "finished", "type": "string" },
              "id": { "type": "string" },
              "configurationId": { "type": "string" },
              "repetition": { "minimum": 1, "type": "integer" },
              "resultFile": { "type": "string" },
              "resultSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
              "taskSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
              "adapterSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "adapter": {
                "additionalProperties": false,
                "type": "object",
                "required": ["kind", "actions"],
                "properties": {
                  "kind": { "const": "fake", "type": "string" },
                  "actions": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "required": ["kind", "path", "content"],
                          "properties": {
                            "kind": { "const": "writeFile", "type": "string" },
                            "path": {
                              "minLength": 1,
                              "maxLength": 1024,
                              "type": "string"
                            },
                            "content": { "type": "string" }
                          }
                        },
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "required": ["kind", "command", "args"],
                          "properties": {
                            "kind": { "const": "runCommand", "type": "string" },
                            "command": { "minLength": 1, "type": "string" },
                            "args": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "cwd": {
                              "minLength": 1,
                              "maxLength": 1024,
                              "type": "string"
                            },
                            "env": {
                              "type": "object",
                              "patternProperties": {
                                "^(.*)$": { "type": "string" }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "runner": {
                "additionalProperties": false,
                "type": "object",
                "required": ["name", "version", "node", "platform", "arch"],
                "properties": {
                  "name": { "const": "agent-eval-runner", "type": "string" },
                  "version": { "type": "string" },
                  "node": { "type": "string" },
                  "platform": { "type": "string" },
                  "arch": { "type": "string" }
                }
              },
              "source": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "repositoryPath",
                  "requestedRevision",
                  "resolvedRevision"
                ],
                "properties": {
                  "repositoryPath": { "type": "string" },
                  "requestedRevision": { "type": "string" },
                  "resolvedRevision": {
                    "anyOf": [{ "type": "string" }, { "type": "null" }]
                  }
                }
              },
              "status": {
                "anyOf": [
                  { "const": "succeeded", "type": "string" },
                  { "const": "failed", "type": "string" },
                  { "const": "interrupted", "type": "string" }
                ]
              },
              "outcome": {
                "anyOf": [
                  { "const": "completed", "type": "string" },
                  { "const": "agent_failed", "type": "string" },
                  { "const": "command_budget_exceeded", "type": "string" },
                  { "const": "wall_clock_exceeded", "type": "string" },
                  { "const": "cancelled", "type": "string" },
                  { "const": "runner_error", "type": "string" }
                ]
              },
              "score": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "version",
                  "passed",
                  "failed",
                  "skipped",
                  "total",
                  "ratio"
                ],
                "properties": {
                  "version": { "const": "2", "type": "string" },
                  "passed": { "minimum": 0, "type": "integer" },
                  "failed": { "minimum": 0, "type": "integer" },
                  "skipped": { "minimum": 0, "type": "integer" },
                  "total": { "minimum": 0, "type": "integer" },
                  "ratio": {
                    "anyOf": [
                      { "minimum": 0, "maximum": 1, "type": "number" },
                      { "type": "null" }
                    ]
                  }
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": ["id", "kind", "status"],
                      "properties": {
                        "id": { "type": "string" },
                        "kind": {
                          "anyOf": [
                            { "const": "test", "type": "string" },
                            { "const": "lint", "type": "string" },
                            { "const": "custom", "type": "string" }
                          ]
                        },
                        "status": {
                          "anyOf": [
                            { "const": "passed", "type": "string" },
                            { "const": "failed", "type": "string" }
                          ]
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": ["id", "kind", "status", "reason"],
                      "properties": {
                        "id": { "type": "string" },
                        "kind": {
                          "anyOf": [
                            { "const": "test", "type": "string" },
                            { "const": "lint", "type": "string" },
                            { "const": "custom", "type": "string" }
                          ]
                        },
                        "status": { "const": "skipped", "type": "string" },
                        "reason": {
                          "anyOf": [
                            { "const": "cancelled", "type": "string" },
                            {
                              "const": "wall_clock_exceeded",
                              "type": "string"
                            },
                            { "const": "checkout_failed", "type": "string" },
                            { "const": "check_error", "type": "string" }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              "durationMs": { "minimum": 0, "type": "number" },
              "commandCount": { "minimum": 0, "type": "integer" },
              "patchBytes": {
                "anyOf": [
                  { "minimum": 0, "type": "integer" },
                  { "type": "null" }
                ]
              },
              "usage": {
                "additionalProperties": false,
                "type": "object",
                "required": ["modelTokens", "modelCostUsd"],
                "properties": {
                  "modelTokens": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": ["status", "source", "value"],
                        "properties": {
                          "status": { "const": "known", "type": "string" },
                          "source": {
                            "anyOf": [
                              { "const": "measured", "type": "string" },
                              { "const": "not_applicable", "type": "string" }
                            ]
                          },
                          "value": { "minimum": 0, "type": "integer" }
                        }
                      },
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": ["status", "reason"],
                        "properties": {
                          "status": { "const": "unknown", "type": "string" },
                          "reason": { "minLength": 1, "type": "string" }
                        }
                      }
                    ]
                  },
                  "modelCostUsd": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": ["status", "source", "value"],
                        "properties": {
                          "status": { "const": "known", "type": "string" },
                          "source": {
                            "anyOf": [
                              { "const": "measured", "type": "string" },
                              { "const": "not_applicable", "type": "string" }
                            ]
                          },
                          "value": { "minimum": 0, "type": "number" }
                        }
                      },
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": ["status", "reason"],
                        "properties": {
                          "status": { "const": "unknown", "type": "string" },
                          "reason": { "minLength": 1, "type": "string" }
                        }
                      }
                    ]
                  }
                }
              },
              "errors": { "type": "array", "items": { "type": "string" } }
            }
          },
          {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "id",
                  "configurationId",
                  "repetition",
                  "adapterSha256",
                  "state",
                  "resultFile"
                ],
                "properties": {
                  "id": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "configurationId": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "repetition": { "minimum": 1, "type": "integer" },
                  "adapterSha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "state": { "const": "pending", "type": "string" },
                  "resultFile": { "type": "null" }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "id",
                  "configurationId",
                  "repetition",
                  "adapterSha256",
                  "state",
                  "resultFile"
                ],
                "properties": {
                  "id": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "configurationId": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "repetition": { "minimum": 1, "type": "integer" },
                  "adapterSha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "state": { "const": "running", "type": "string" },
                  "resultFile": { "type": "string" }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "id",
                  "configurationId",
                  "repetition",
                  "adapterSha256",
                  "state",
                  "resultFile",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "configurationId": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "repetition": { "minimum": 1, "type": "integer" },
                  "adapterSha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "state": { "const": "not_started", "type": "string" },
                  "resultFile": { "type": "null" },
                  "reason": {
                    "anyOf": [
                      { "const": "cancelled", "type": "string" },
                      { "const": "persistence_error", "type": "string" }
                    ]
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "id",
                  "configurationId",
                  "repetition",
                  "adapterSha256",
                  "state",
                  "resultFile",
                  "error"
                ],
                "properties": {
                  "id": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "configurationId": {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  },
                  "repetition": { "minimum": 1, "type": "integer" },
                  "adapterSha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "state": { "const": "persistence_failed", "type": "string" },
                  "resultFile": { "type": "null" },
                  "error": { "type": "string" }
                }
              }
            ]
          }
        ]
      }
    },
    "summary": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scheduled",
        "finished",
        "succeeded",
        "failed",
        "interrupted",
        "notStarted",
        "pending",
        "running",
        "persistenceFailed",
        "usage"
      ],
      "properties": {
        "scheduled": { "minimum": 0, "type": "integer" },
        "finished": { "minimum": 0, "type": "integer" },
        "succeeded": { "minimum": 0, "type": "integer" },
        "failed": { "minimum": 0, "type": "integer" },
        "interrupted": { "minimum": 0, "type": "integer" },
        "notStarted": { "minimum": 0, "type": "integer" },
        "pending": { "minimum": 0, "type": "integer" },
        "running": { "minimum": 0, "type": "integer" },
        "persistenceFailed": { "minimum": 0, "type": "integer" },
        "usage": {
          "additionalProperties": false,
          "type": "object",
          "required": ["modelTokens", "modelCostUsd"],
          "properties": {
            "modelTokens": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": ["status", "source", "value"],
                  "properties": {
                    "status": { "const": "known", "type": "string" },
                    "source": {
                      "anyOf": [
                        { "const": "measured", "type": "string" },
                        { "const": "not_applicable", "type": "string" }
                      ]
                    },
                    "value": { "minimum": 0, "type": "integer" }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": ["status", "reason"],
                  "properties": {
                    "status": { "const": "unknown", "type": "string" },
                    "reason": { "minLength": 1, "type": "string" }
                  }
                }
              ]
            },
            "modelCostUsd": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": ["status", "source", "value"],
                  "properties": {
                    "status": { "const": "known", "type": "string" },
                    "source": {
                      "anyOf": [
                        { "const": "measured", "type": "string" },
                        { "const": "not_applicable", "type": "string" }
                      ]
                    },
                    "value": { "minimum": 0, "type": "number" }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": ["status", "reason"],
                  "properties": {
                    "status": { "const": "unknown", "type": "string" },
                    "reason": { "minLength": 1, "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
