{
  "$id": "https://agent-eval-runner.dev/schemas/resource-ledger-v1.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": ["schemaVersion", "poolId", "policySha256", "limits", "records"],
  "properties": {
    "schemaVersion": { "const": "1", "type": "string" },
    "poolId": {
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "policySha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "limits": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "poolBytes",
        "poolEntries",
        "dockerVolumeBytes",
        "dockerContainers",
        "dockerVolumes",
        "records"
      ],
      "properties": {
        "poolBytes": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "poolEntries": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dockerVolumeBytes": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dockerContainers": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dockerVolumes": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "records": { "minimum": 1, "maximum": 1000, "type": "integer" }
      }
    },
    "records": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "state",
          "ownerPid",
          "createdAt",
          "attemptId",
          "taskSha256",
          "comparisonSha256",
          "reserved",
          "charged",
          "measurement",
          "docker",
          "resultSha256",
          "error"
        ],
        "properties": {
          "id": {
            "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "state": {
            "anyOf": [
              { "const": "active", "type": "string" },
              { "const": "retained", "type": "string" },
              { "const": "completed", "type": "string" }
            ]
          },
          "ownerPid": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "createdAt": { "type": "string" },
          "attemptId": { "maxLength": 128, "type": "string" },
          "taskSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
          "comparisonSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
          "reserved": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "poolBytes",
              "poolEntries",
              "dockerVolumeBytes",
              "dockerContainers",
              "dockerVolumes",
              "records"
            ],
            "properties": {
              "poolBytes": { "const": 805306368, "type": "number" },
              "poolEntries": { "const": 60000, "type": "number" },
              "dockerVolumeBytes": { "const": 402653184, "type": "number" },
              "dockerContainers": { "const": 4, "type": "number" },
              "dockerVolumes": { "const": 2, "type": "number" },
              "records": { "const": 1, "type": "number" }
            }
          },
          "charged": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "poolBytes",
              "poolEntries",
              "dockerVolumeBytes",
              "dockerContainers",
              "dockerVolumes",
              "records"
            ],
            "properties": {
              "poolBytes": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "poolEntries": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "dockerVolumeBytes": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "dockerContainers": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "dockerVolumes": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "records": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            }
          },
          "measurement": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": ["kind", "reason"],
                "properties": {
                  "kind": { "const": "unknown", "type": "string" },
                  "reason": { "maxLength": 4096, "type": "string" }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": ["kind", "poolBytes", "poolEntries"],
                "properties": {
                  "kind": { "const": "measured", "type": "string" },
                  "poolBytes": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "poolEntries": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "docker": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "role",
                "containerName",
                "holderName",
                "volumeName",
                "containerId",
                "holderId",
                "containerCleanup",
                "storageCleanup"
              ],
              "properties": {
                "role": {
                  "anyOf": [
                    { "const": "agent", "type": "string" },
                    { "const": "preparation", "type": "string" }
                  ]
                },
                "containerName": { "type": "string" },
                "holderName": { "type": "string" },
                "volumeName": { "type": "string" },
                "containerId": {
                  "anyOf": [
                    { "maxLength": 4096, "type": "string" },
                    { "type": "null" }
                  ]
                },
                "holderId": {
                  "anyOf": [
                    { "maxLength": 4096, "type": "string" },
                    { "type": "null" }
                  ]
                },
                "containerCleanup": {
                  "anyOf": [
                    { "const": "reserved", "type": "string" },
                    { "const": "not_created", "type": "string" },
                    { "const": "pending", "type": "string" },
                    { "const": "removed", "type": "string" },
                    { "const": "failed", "type": "string" }
                  ]
                },
                "storageCleanup": {
                  "anyOf": [
                    { "const": "reserved", "type": "string" },
                    { "const": "not_created", "type": "string" },
                    { "const": "pending", "type": "string" },
                    { "const": "removed", "type": "string" },
                    { "const": "retained", "type": "string" },
                    { "const": "failed", "type": "string" }
                  ]
                }
              }
            }
          },
          "resultSha256": {
            "anyOf": [
              { "pattern": "^[0-9a-f]{64}$", "type": "string" },
              { "type": "null" }
            ]
          },
          "error": {
            "anyOf": [
              { "maxLength": 4096, "type": "string" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}
