{
  "$id": "https://agent-eval-runner.dev/schemas/resource-policy-v1.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": ["schemaVersion", "limits"],
  "properties": {
    "schemaVersion": { "const": "1", "type": "string" },
    "limits": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "poolBytes",
        "poolEntries",
        "dockerVolumeBytes",
        "dockerContainers",
        "dockerVolumes",
        "records"
      ],
      "properties": {
        "poolBytes": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "poolEntries": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dockerVolumeBytes": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dockerContainers": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dockerVolumes": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "records": { "minimum": 1, "maximum": 1000, "type": "integer" }
      }
    }
  }
}
